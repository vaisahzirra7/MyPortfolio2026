# Copy this file to .env and fill in your own values before running the site.

PORT=3000

# Session secret - use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login credentials
ADMIN_USERNAME=admin

# Generate this by running: npm run hash-password
# It will prompt you for a password and print the hash to paste here.
ADMIN_PASSWORD_HASH=
